APP_NAME=Lotus Hotel AI
SECRET_KEY=change-this-secret-in-production
DATABASE_URL=sqlite:///./data/hotel.db
# MySQL: mysql+pymysql://hotel_user:hotel_password@localhost:3306/hotel_ai?charset=utf8mb4
# PostgreSQL (Render internal URL on Render, external URL + sslmode=require on local):
# DATABASE_URL=postgresql+psycopg://hotel_user:password@localhost:5432/hotel_ai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=2048
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Production: generate SECRET_KEY randomly (>=32 characters); run Alembic first.
# Production disables demo seeding and automatic schema creation.
APP_ENV=development
AUTO_CREATE_SCHEMA=true
SEED_DEMO_DATA=true
# Required only to bootstrap an empty production database; never use Admin@123.
BOOTSTRAP_ADMIN_PASSWORD=
